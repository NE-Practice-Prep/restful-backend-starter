# PostgreSQL (shared by all microservices)
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5435/restful?schema=public"

# API Gateway
GATEWAY_PORT=3001
CORS_ORIGIN=http://localhost:3000
APP_URL=http://localhost:3000

# Microservice TCP ports
AUTH_SERVICE_PORT=3002
USERS_SERVICE_PORT=3003
EXTINGUISHERS_SERVICE_PORT=3004
INSPECTIONS_SERVICE_PORT=3005
REPORTS_SERVICE_PORT=3006

JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d

# Email notifications (required for expiry, inspection, and invitation emails)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-account@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM="TZW LTD <youraccount@gmail.com>"
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
