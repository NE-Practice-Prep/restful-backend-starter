# Database
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/restufl

# Server
PORT=3001
CORS_ORIGIN=http://localhost:3000

# JWT (required — use a long random string in production)
JWT_SECRET=change_me_to_a_long_random_secret
JWT_EXPIRES_IN=3600s

# Frontend URL (used in invitation emails)
APP_URL=http://localhost:3000

# SMTP (optional — verification codes are logged to the console when unset)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@example.com
