generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  admin
  editor
  viewer
  customer
}

enum UserStatus {
  active
  invited
  suspended
}

enum ExtinguisherStatus {
  available
  assigned
  retired
}

enum AssignmentAction {
  assigned
  unassigned
  replaced
}

enum RenewalRequestStatus {
  pending
  approved
  rejected
}

enum InAppNotificationType {
  expiring_soon
  expired
  renewal_approved
  renewal_rejected
}

model User {
  id                         String              @id @default(cuid())
  email                      String              @unique
  name                       String              @default("")
  passwordHash               String?
  role                       UserRole            @default(viewer)
  status                     UserStatus          @default(invited)
  phone                      String?
  location                   String?
  bio                        String              @default("")
  avatarUrl                  String?
  emailVerified              Boolean             @default(false)
  emailVerificationCode      String?
  emailVerificationExpiresAt DateTime?
  createdAt                  DateTime            @default(now())
  updatedAt                  DateTime            @updatedAt
  customerProfile            Customer?
  inAppNotifications         InAppNotification[]
}

model Customer {
  id                String              @id @default(cuid())
  name              String
  email             String              @unique
  phone             String?
  address           String?
  contactNotes      String              @default("")
  userId            String?             @unique
  user              User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  extinguishers     FireExtinguisher[]
  renewalRequests   RenewalRequest[]
  assignmentHistory AssignmentHistory[]
  expiryEmailLogs   ExpiryEmailLog[]
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
}

model FireExtinguisher {
  id                  String              @id @default(cuid())
  serialNumber        String              @unique
  type                String
  manufactureDate     DateTime            @db.Date
  expiryDate          DateTime            @db.Date
  status              ExtinguisherStatus  @default(available)
  customerId          String?
  customer            Customer?           @relation(fields: [customerId], references: [id], onDelete: SetNull)
  assignmentHistory   AssignmentHistory[]
  renewalRequests     RenewalRequest[]
  renewalReplacements RenewalRequest[]    @relation("RenewalReplacement")
  expiryEmailLogs     ExpiryEmailLog[]
  inAppNotifications  InAppNotification[]
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
}

model AssignmentHistory {
  id             String           @id @default(cuid())
  extinguisherId String
  extinguisher   FireExtinguisher @relation(fields: [extinguisherId], references: [id], onDelete: Cascade)
  customerId     String?
  customer       Customer?        @relation(fields: [customerId], references: [id], onDelete: SetNull)
  action         AssignmentAction
  notes          String           @default("")
  performedById  String?
  createdAt      DateTime         @default(now())
}

model RenewalRequest {
  id                        String               @id @default(cuid())
  customerId                String
  customer                  Customer             @relation(fields: [customerId], references: [id], onDelete: Cascade)
  extinguisherId            String
  extinguisher              FireExtinguisher     @relation(fields: [extinguisherId], references: [id], onDelete: Cascade)
  status                    RenewalRequestStatus @default(pending)
  replacementExtinguisherId String?
  replacementExtinguisher   FireExtinguisher?    @relation("RenewalReplacement", fields: [replacementExtinguisherId], references: [id], onDelete: SetNull)
  adminNote                 String               @default("")
  createdAt                 DateTime             @default(now())
  updatedAt                 DateTime             @updatedAt
}

model InAppNotification {
  id               String                @id @default(cuid())
  userId           String
  user             User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  type             InAppNotificationType
  title            String
  message          String
  read             Boolean               @default(false)
  extinguisherId   String?
  extinguisher     FireExtinguisher?     @relation(fields: [extinguisherId], references: [id], onDelete: SetNull)
  renewalRequestId String?
  createdAt        DateTime              @default(now())
}

model ExpiryEmailLog {
  id             String           @id @default(cuid())
  customerId     String
  customer       Customer         @relation(fields: [customerId], references: [id], onDelete: Cascade)
  extinguisherId String
  extinguisher   FireExtinguisher @relation(fields: [extinguisherId], references: [id], onDelete: Cascade)
  emailType      String
  sentAt         DateTime         @default(now())

  @@unique([extinguisherId, emailType])
}

model AppSettings {
  id                String   @id @default("default")
  expiryWarningDays Int      @default(30)
  updatedAt         DateTime @updatedAt
}
