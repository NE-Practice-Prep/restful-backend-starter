{
  "name": "restufl-backend",
  "private": true,
  "packageManager": "pnpm@10.16.1",
  "type": "module",
  "scripts": {
    "dev": "pnpm run dev:all",
    "dev:gateway": "tsx watch apps/api-gateway/src/main.ts",
    "dev:auth": "tsx watch apps/auth-service/src/main.ts",
    "dev:users": "tsx watch apps/users-service/src/main.ts",
    "dev:fire": "tsx watch apps/fire-extinguisher-service/src/main.ts",
    "dev:reporting": "tsx watch apps/reporting-service/src/main.ts",
    "dev:all": "concurrently -n gateway,auth,users,fire,reporting -c blue,green,yellow,magenta,cyan \"pnpm dev:gateway\" \"pnpm dev:auth\" \"pnpm dev:users\" \"pnpm dev:fire\" \"pnpm dev:reporting\"",
    "build": "tsc",
    "start": "node dist/apps/api-gateway/src/main.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "db:seed:demo": "tsx ./prisma/seed-demo-data.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.17",
    "@nestjs/core": "^11.1.17",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/microservices": "^11.1.24",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.1.17",
    "@nestjs/swagger": "^11.4.4",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "^17.2.3",
    "multer": "^2.1.1",
    "nodemailer": "^8.0.10",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/multer": "^2.1.0",
    "@types/node": "^25.5.0",
    "@types/nodemailer": "^8.0.0",
    "@types/passport-jwt": "^4.0.1",
    "prisma": "^7.8.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "concurrently": "^9.2.1",
    "vitest": "^4.1.7"
  }
}
